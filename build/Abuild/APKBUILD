pkgname=enca
pkgver=1.20
pkgrel=0
pkgdesc="Charset analyser and converter"
url="https://cihar.com/software/enca/"
arch="all"
license="GPL-2.0-only"
subpackages="$pkgname-dev $pkgname-doc"
source="https://github.com/Project-OSS-Revival/enca/releases/download/$pkgver/enca-$pkgver.tar.xz
    "

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --libexecdir=/usr/lib \
        --enable-external
    make
}

check() {
    # Language support test fail due to locale not supported
    make check | true
}

package() {
    make DESTDIR="$pkgdir" install
}

sha512sums="
